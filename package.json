{
  "name": "workspace-tools-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Pi SDK coding tools for ChatGPT over OpenAI Secure MCP Tunnel",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "npm --prefix web install --no-audit --no-fund",
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs && npm --prefix web run build",
    "build:server": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "start": "node dist/app.mjs",
    "dev": "tsx src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx tests/smoke.ts",
    "benchmark": "npm run build:server && node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fflate": "0.8.2",
    "typebox": "1.3.27",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
