{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workspace Tools",
  "version": "../../package.json",
  "identifier": "com.workspacetools.mcp",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Workspace Tools Manager",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Local coding tools for ChatGPT and MCP clients",
    "longDescription": "Manage several ChatGPT accounts, each with its own OpenAI tunnel, exposing local coding tools over MCP.",
    "externalBin": ["binaries/wtm-bun"],
    "resources": { "resources/app/": "app/" },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
