{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI_Local_Hub",
  "version": "../../package.json",
  "identifier": "com.ailocalhub.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AI Local Hub",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Local MCP tools for AI clients",
    "longDescription": "Manage local MCP instances that connect AI clients to coding tools and future extensions.",
    "externalBin": ["binaries/ai-local-hub-manager", "binaries/ai-local-hub-runtime"],
    "resources": { "resources/app/": "app/" },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwQkFENDdBRDA5RTZFNDIKUldSQ2JwN1FldFM2VUVVR29SYjcxYkxTdUkxQlhuMzNaYTRWVnJtdHROUkoxNEYyZ0JjV0JIcHkK",
      "endpoints": ["https://github.com/BillyND/ai-local-hub/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
