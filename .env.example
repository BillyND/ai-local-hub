# Values may be exported in your shell or loaded with Node --env-file.
# Missing values are requested interactively; the API key prompt is hidden.
WORKSPACE_ROOT=
OPENAI_TUNNEL_ID=
OPENAI_API_KEY=
# Optional: defaults to ~/.config/workspace-tools-mcp/config.json
WORKSPACE_TOOLS_CONFIG_FILE=
# Optional: defaults to ~/.cache/workspace-tools-mcp
WORKSPACE_TOOLS_CACHE_DIR=
